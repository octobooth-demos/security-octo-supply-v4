{
    "name": "octocat/supplier-portal",
    "description": "OctoCAT Supply Chain - Supplier Portal (Legacy PHP Service)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "vlucas/phpdotenv": "^5.6",
        "monolog/monolog": "^3.5",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "OctoCat\\SupplierPortal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OctoCat\\SupplierPortal\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse src --level=6"
    }
}
